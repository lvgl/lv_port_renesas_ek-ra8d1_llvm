    ],
    "getStartedInstructions": "Follow the instructions in README.md to install e2 studio and the LLVM Embedded Toolchain for Arm, get the FSP Packs, and build and debug the project.",
    "settings": [
        {
            "type": "dropdown",
            "label": "Use Dave2D GPU",
            "options": [
                {
                    "name": "Yes",
                    "value": "1",
                    "default": "true"
                },
                {
                    "name": "No",
                    "value": "0"
                }
            ],
            "actions": [
                {
                    "toReplace": "#define LV_USE_DRAW_DAVE2D .*",
                    "newContent": "#define LV_USE_DRAW_DAVE2D {value}",
                    "filePath": "src/lv_conf_user.h"
                }
            ]
        },
        {
            "type": "dropdown",
            "label": "Show performance monitor",
