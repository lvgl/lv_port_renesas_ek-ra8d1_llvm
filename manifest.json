        "specs": {
            "MCU": "R7FA8D1BHECBD (Cortex-M85, 480MHz)",
            "RAM": "1MB internal, 64MB external SDRAM",
            "Flash": "2MB internal, 64MB External Octo-SPI Flash",
            "GPU": "Dave2D",
            "Resolution": "480x854",
            "Display Size": "4.5”",
            "Interface": "2-lane MIPI",
            "Color Depth": "24-bit",
            "Technology": "IPS",
            "DPI": "217 px/inch",
            "Touch Pad": "Capacitive"
