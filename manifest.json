                    "name": "No",
                    "value": "0"
                }
            ],
            "actions": [
                {
                    "toReplace": "#define LV_USE_PERF_MONITOR .*",
                    "newContent": "#define LV_USE_PERF_MONITOR {value}",
                    "filePath": "src/lv_conf_user.h"
                }
            ]
        }
    ]
