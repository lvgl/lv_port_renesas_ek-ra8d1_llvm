# Mirrors the effective LVGL configuration: what the FSP configurator writes into
# ra_cfg/fsp_cfg/lvgl/lvgl/lv_conf.h plus the src/lv_conf_user.h overlay. Consumed
# by lvgl/lvgl's scripts/release_branch_updater.py, so keep it in sync with
# src/lv_conf_user.h.

LV_COLOR_DEPTH          16
LV_MEM_SIZE             (256 * 1024)

LV_USE_OS               LV_OS_FREERTOS

LV_USE_DRAW_DAVE2D      1
LV_USE_RENESAS_GLCDC    1

LV_USE_DRAW_SW_COMPLEX_GRADIENTS 1
LV_OBJ_STYLE_CACHE      1

LV_USE_OBJ_NAME         1
LV_USE_TRANSLATION      1

LV_FONT_MONTSERRAT_14   1
LV_FONT_MONTSERRAT_24   1

LV_USE_SYSMON           1
LV_USE_PERF_MONITOR     1
LV_USE_MEM_MONITOR      1
LV_SYSMON_GET_IDLE      get_idle_percent

LV_BUILD_DEMOS          1
LV_USE_DEMO_WIDGETS     1
LV_USE_DEMO_BENCHMARK   1
